{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevOS Cockpit",
  "version": "1.0.0",
  "identifier": "br.aspp.devos.cockpit",
  "build": {
    "frontendDist": "../dist-cockpit",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "pnpm run dev:cockpit",
    "beforeBuildCommand": "pnpm run build:cockpit"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevOS — DAO Master Cockpit",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "capabilities": [
        "desktop-vault",
        "cockpit-real-estate"
      ],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost tauri: https://api.asppibra.com http://localhost:8787; frame-src 'none'; object-src 'none'; base-uri 'self';",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
