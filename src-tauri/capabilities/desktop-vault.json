{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-vault",
  "description": "Capability da janela principal do DevOS para operações do cofre, carteiras, diagnóstico do dispositivo, geração de documentos e controles específicos da janela. A exposição dos comandos personalizados deve permanecer alinhada ao ACL gerado no build e à autorização validada pelos handlers Rust.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-device-status",
    "allow-get-vault-status",
    "allow-init-master-password",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-generate-seed-and-preview",
    "allow-reveal-pending-mnemonic",
    "allow-cancel-pending-creation",
    "allow-confirm-and-save-wallets",
    "allow-list-stored-wallets",
    "allow-export-authorized-secret",
    "allow-export-vault-backup",
    "allow-restore-vault-backup",
    "allow-fetch-wallet-balance",
    "allow-batch-fetch-wallet-balances",
    "allow-generate-document",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-center",
    "core:window:allow-set-size"
  ]
}
