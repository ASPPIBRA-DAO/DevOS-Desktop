{
  "name": "@asppibra/devos-desktop",
  "author": "ASPPIBRA DAO",
  "version": "1.0.0",
  "description": "DevOS Desktop — Aplicação Nativa Institucional com IPFS & Rede de Pinning (Tauri v2)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode node",
    "build": "tsc && vite build --mode node",
    "dev:node": "vite --mode node",
    "dev:admin": "vite --mode cockpit",
    "dev:cockpit": "vite --mode cockpit",
    "build:node": "tsc && vite build --mode node",
    "build:admin": "tsc && vite build --mode cockpit",
    "build:cockpit": "tsc && vite build --mode cockpit",
    "tauri:node:dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 GDK_BACKEND=x11 tauri dev --config src-tauri/tauri.node.conf.json",
    "tauri:admin:dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 GDK_BACKEND=x11 tauri dev --config src-tauri/tauri.cockpit.conf.json",
    "tauri:cockpit:dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 GDK_BACKEND=x11 tauri dev --config src-tauri/tauri.cockpit.conf.json",
    "tauri:node:build": "tauri build --config src-tauri/tauri.node.conf.json",
    "tauri:admin:build": "tauri build --config src-tauri/tauri.cockpit.conf.json",
    "tauri:cockpit:build": "tauri build --config src-tauri/tauri.cockpit.conf.json",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "vitest run",
    "ts:check": "tsc --noEmit",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "clean": "rm -rf node_modules dist-node dist-cockpit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@hookform/resolvers": "5.9.1",
    "@iconify/react": "^6.0.2",
    "@mui/lab": "9.0.0-beta.2",
    "@mui/material": "^9.0.0",
    "@mui/stylis-plugin-rtl": "^9.0.0",
    "@mui/x-data-grid": "^9.0.1",
    "@mui/x-date-pickers": "^9.0.0",
    "@react-pdf/renderer": "^4.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.2.0",
    "apexcharts": "^5.3.5",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "dompurify": "^3.4.12",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "^1.39.10",
    "framer-motion": "^12.23.22",
    "minimal-shared": "^1.1.0",
    "mui-one-time-password-input": "^6.0.0",
    "nprogress": "^0.2.0",
    "react": "^19.1.1",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.63.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.3",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "simplebar-react": "^3.3.2",
    "sonner": "^2.0.7",
    "stylis": "^4.3.6",
    "swr": "^2.3.6",
    "three": "^0.186.1",
    "three-globe": "^2.45.6",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/autosuggest-highlight": "^3.2.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.5.2",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@types/stylis": "^4.2.7",
    "@types/three": "^0.186.0",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "dependency-cruiser": "^16.10.3",
    "eslint": "^9.36.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.0.8",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^4.1.10"
  }
}
